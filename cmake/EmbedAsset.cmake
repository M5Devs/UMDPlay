# Embed a binary file as a C++ byte array.
#
#   cmake -DINPUT=<file> -DOUTPUT=<cpp> -DSYMBOL=<name> -P cmake/EmbedAsset.cmake
#
# Emits two externally-linked symbols: `SYMBOL` (the bytes) and `SYMBOL_len`.
# Used to bake the official logo PNG into the executable, so the WMC hub header
# and the window icon work from a bare binary (release bundles ship no assets/).

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hexlen)
math(EXPR _bytelen "${_hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")

file(WRITE "${OUTPUT}"
"// Auto-generated by cmake/EmbedAsset.cmake. Do not edit.
extern const unsigned char ${SYMBOL}[];
extern const unsigned int ${SYMBOL}_len;
extern const unsigned char ${SYMBOL}[] = {${_bytes}};
extern const unsigned int ${SYMBOL}_len = ${_bytelen}u;
")
